@@ -0,0 +1,321 @@
+name: "Agentic Eval Pipeline"
+
+# Generated by AIRE v1.0 for Billing-Cycle at the EPIC-1 STOP CHECKPOINT.
+# Every command below comes from this repository's real build files:
+#   src/backend/requirements.txt  - fastapi, uvicorn[standard], python-multipart
+#   src/frontend/package.json     - scripts: dev, build, lint (oxlint), preview
+# Every threshold comes from .evals/config.json. CI re-verifies the local gates; it never relaxes them.
+
+on:
+  pull_request:
+    branches:
+      - "main"
+      - "epic/**"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pull-requests: write
+
+concurrency:
+  group: "eval-${{ github.workflow }}-${{ github.ref }}"
+  cancel-in-progress: true
+
+env:
+  PYTHON_VERSION: "3.13"
+  NODE_VERSION: "22"
+  EVAL_KEY: "evidence"
+
+jobs:
+  stage-1-deterministic-gates:
+    name: "Stage 1: deterministic gates D1-D7"
+    runs-on: ubuntu-latest
+    outputs:
+      verdict: "${{ steps.static.outcome }}"
+    steps:
+      - name: "Checkout with full history"
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: "Set up Python"
+        uses: actions/setup-python@v5
+        with:
+          python-version: "${{ env.PYTHON_VERSION }}"
+
+      - name: "Set up Node"
+        uses: actions/setup-node@v4
+        with:
+          node-version: "${{ env.NODE_VERSION }}"
+
+      - name: "Install backend runtime dependencies"
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r src/backend/requirements.txt
+
+      - name: "Install CI analysis tools"
+        run: |
+          pip install ruff mypy bandit semgrep pip-audit pip-licenses radon
+
+      - name: "Install frontend dependencies"
+        # src/frontend/.gitignore excludes package-lock.json, so there is no committed
+        # lockfile and `npm ci` would fail. `npm install` is the correct command for
+        # this repository's chosen policy.
+        run: npm --prefix src/frontend install
+
+      - name: "Resolve base SHA"
+        id: base
+        run: |
+          BASE="${{ github.event.pull_request.base.sha }}"
+          if [ -z "$BASE" ]; then
+            BASE="$(git rev-parse HEAD~1 || git rev-parse HEAD)"
+          fi
+          echo "sha=$BASE" >> "$GITHUB_OUTPUT"
+          echo "Base SHA: $BASE"
+
+      - name: "D1-D7: static eval gate"
+        id: static
+        run: |
+          chmod +x .evals/scripts/run-static-evals.sh
+          bash .evals/scripts/run-static-evals.sh "${{ steps.base.outputs.sha }}" ".evals/${{ env.EVAL_KEY }}/static"
+
+      - name: "Upload static evidence"
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: "static-evidence"
+          path: ".evals/${{ env.EVAL_KEY }}/static"
+          if-no-files-found: warn
+
+# --------------------------------------------------------------------------------
+# SonarQube DISABLED at the user's request (answered 'skip' at the CI setup gate).
+# To enable: add the GitHub Actions secrets SONAR_TOKEN and SONAR_HOST_URL, set
+# sonar.organization in sonar-project.properties, uncomment the job below, and set
+# sonarqube.enabled to true in .evals/config.json.
+# sonar-project.properties is deliberately KEPT, so re-enabling needs only the secrets.
+# semgrep (D3) and the 16-rule Security Baseline review still run and still block.
+# --------------------------------------------------------------------------------
+#  stage-1b-sonarqube:
+#    name: "Stage 1b: SonarQube quality gate"
+#    runs-on: ubuntu-latest
+#    # SonarQube is additive to D3's semgrep scan, never a replacement. The job skips
+#    # itself cleanly when the secrets are absent, so the pipeline is fully gated with
+#    # or without a Sonar server.
+#    steps:
+#      - name: "Checkout with full history"
+#        uses: actions/checkout@v4
+#        with:
+#          fetch-depth: 0
+
+#      - name: "Check whether SonarQube is configured"
+#        id: check
+#        env:
+#          SONAR_TOKEN: "${{ secrets.SONAR_TOKEN }}"
+#          SONAR_HOST_URL: "${{ secrets.SONAR_HOST_URL }}"
+#        run: |
+#          if [ -n "$SONAR_TOKEN" ] && [ -n "$SONAR_HOST_URL" ]; then
+#            echo "configured=true" >> "$GITHUB_OUTPUT"
+#          else
+#            echo "configured=false" >> "$GITHUB_OUTPUT"
+#            echo "SONAR_TOKEN or SONAR_HOST_URL is not set. Skipping the SonarQube scan."
+#            echo "semgrep (D3) and the Security Baseline review still run and still block."
+#          fi
+
+#      - name: "SonarQube scan"
+#        if: steps.check.outputs.configured == 'true'
+#        uses: SonarSource/sonarqube-scan-action@v4
+#        env:
+#          SONAR_TOKEN: "${{ secrets.SONAR_TOKEN }}"
+#          SONAR_HOST_URL: "${{ secrets.SONAR_HOST_URL }}"
+
+#      - name: "SonarQube quality gate"
+#        if: steps.check.outputs.configured == 'true'
+#        uses: SonarSource/sonarqube-quality-gate-action@v1
+#        timeout-minutes: 5
+#        env:
+#          SONAR_TOKEN: "${{ secrets.SONAR_TOKEN }}"
+#          SONAR_HOST_URL: "${{ secrets.SONAR_HOST_URL }}"
+
+  stage-2-tests-and-behaviour:
+    name: "Stage 2: unit tests, coverage and behaviour tiers"
+    runs-on: ubuntu-latest
+    needs: stage-1-deterministic-gates
+    if: always()
+    steps:
+      - name: "Checkout with full history"
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+
+      - name: "Set up Python"
+        uses: actions/setup-python@v5
+        with:
+          python-version: "${{ env.PYTHON_VERSION }}"
+
+      - name: "Install backend and test dependencies"
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r src/backend/requirements.txt
+          pip install pytest pytest-cov pytest-bdd httpx
+
+      - name: "Resolve base SHA"
+        id: base
+        run: |
+          BASE="${{ github.event.pull_request.base.sha }}"
+          if [ -z "$BASE" ]; then
+            BASE="$(git rev-parse HEAD~1 || git rev-parse HEAD)"
+          fi
+          echo "sha=$BASE" >> "$GITHUB_OUTPUT"
+
+      - name: "Select behaviour tiers from the PR target branch"
+        id: tiers
+        run: |
+          BASE_REF="${{ github.event.pull_request.base.ref }}"
+          if [ "$BASE_REF" = "main" ]; then
+            echo "tiers=B1,B2,B3" >> "$GITHUB_OUTPUT"
+            echo "Epic or integration PR into main: running B1 + B2 + B3"
+          else
+            echo "tiers=B1,B2" >> "$GITHUB_OUTPUT"
+            echo "Story PR into an integration branch: running B1 + B2"
+          fi
+
+      - name: "Unit tests, coverage and behaviour"
+        env:
+          BEHAVIOR_TIERS: "${{ steps.tiers.outputs.tiers }}"
+        run: |
+          chmod +x .evals/scripts/run-evals.sh .evals/scripts/run-static-evals.sh .evals/behavior/run.sh
+          bash .evals/scripts/run-evals.sh "${{ steps.base.outputs.sha }}" ".evals/${{ env.EVAL_KEY }}"
+
+      - name: "Upload eval scorecard"
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: "eval-scorecard"
+          path: ".evals/${{ env.EVAL_KEY }}"
+          if-no-files-found: warn
+
+  stage-3-frontend-build:
+    name: "Stage 3: frontend lint and build"
+    runs-on: ubuntu-latest
+    steps:
+      - name: "Checkout"
+        uses: actions/checkout@v4
+
+      - name: "Set up Node"
+        uses: actions/setup-node@v4
+        with:
+          node-version: "${{ env.NODE_VERSION }}"
+
+      - name: "Install frontend dependencies"
+        # src/frontend/.gitignore excludes package-lock.json, so there is no committed
+        # lockfile and `npm ci` would fail. `npm install` is the correct command for
+        # this repository's chosen policy.
+        run: npm --prefix src/frontend install
+
+      - name: "Lint with oxlint"
+        run: npm --prefix src/frontend run lint
+
+      - name: "Production build"
+        run: npm --prefix src/frontend run build
+
+  stage-4-verdict:
+    name: "Stage 4: verdict"
+    runs-on: ubuntu-latest
+    needs:
+      - stage-1-deterministic-gates
+      - stage-2-tests-and-behaviour
+      - stage-3-frontend-build
+    if: always()
+    steps:
+      - name: "Checkout"
+        uses: actions/checkout@v4
+
+      - name: "Download eval scorecard"
+        uses: actions/download-artifact@v4
+        continue-on-error: true
+        with:
+          name: "eval-scorecard"
+          path: "scorecard"
+
+      - name: "Compute and publish the verdict"
+        run: |
+          S1="${{ needs.stage-1-deterministic-gates.result }}"
+          S2="${{ needs.stage-2-tests-and-behaviour.result }}"
+          S3="${{ needs.stage-3-frontend-build.result }}"
+          echo "Stage 1 deterministic gates : $S1"
+          echo "Stage 2 tests and behaviour : $S2"
+          echo "Stage 3 frontend build      : $S3"
+          {
+            echo "## Agentic Eval Pipeline verdict"
+            echo ""
+            echo "| Stage | Result |"
+            echo "|---|---|"
+            echo "| Stage 1: deterministic gates D1-D7 | $S1 |"
+            echo "| Stage 2: unit tests, coverage, behaviour | $S2 |"
+            echo "| Stage 3: frontend lint and build | $S3 |"
+            echo ""
+            if [ -f scorecard/eval-summary.md ]; then
+              echo "<details><summary>Eval summary</summary>"
+              echo ""
+              cat scorecard/eval-summary.md
+              echo ""
+              echo "</details>"
+            fi
+          } >> "$GITHUB_STEP_SUMMARY"
+          if [ "$S1" != "success" ] || [ "$S2" != "success" ] || [ "$S3" != "success" ]; then
+            echo "VERDICT: FAIL - at least one gate did not pass. The PR is blocked."
+            exit 1
+          fi
+          echo "VERDICT: PASS"
+
+  self-repair:
+    name: "Self-repair failing gates"
+    runs-on: ubuntu-latest
+    needs: stage-4-verdict
+    if: failure() && github.event_name == 'pull_request'
+    permissions:
+      contents: write
+      pull-requests: write
+    steps:
+      - name: "Checkout the PR head branch"
+        uses: actions/checkout@v4
+        with:
+          ref: "${{ github.event.pull_request.head.ref }}"
+          fetch-depth: 0
+          token: "${{ secrets.GITHUB_TOKEN }}"
+
+      - name: "Set up Python"
+        uses: actions/setup-python@v5
+        with:
+          python-version: "${{ env.PYTHON_VERSION }}"
+
+      - name: "Set up Node"
+        uses: actions/setup-node@v4
+        with:
+          node-version: "${{ env.NODE_VERSION }}"
+
+      - name: "Install dependencies and CI tools"
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r src/backend/requirements.txt
+          pip install pytest pytest-cov pytest-bdd httpx ruff mypy bandit semgrep pip-audit pip-licenses radon
+          npm --prefix src/frontend install   # no committed lockfile; see stage 1
+
+      - name: "Download eval scorecard"
+        uses: actions/download-artifact@v4
+        continue-on-error: true
+        with:
+          name: "eval-scorecard"
+          path: ".evals/${{ env.EVAL_KEY }}"
+
+      - name: "Resolve base SHA"
+        id: base
+        run: echo "sha=${{ github.event.pull_request.base.sha }}" >> "$GITHUB_OUTPUT"
+
+      - name: "Run the self-repair agent"
+        env:
+          CLAUDE_CODE_OAUTH_TOKEN: "${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}"
+          ANTHROPIC_API_KEY: "${{ secrets.ANTHROPIC_API_KEY }}"
+        run: |
+          chmod +x .evals/scripts/auto-fix-agent.sh
+          bash .evals/scripts/auto-fix-agent.sh "${{ steps.base.outputs.sha }}" ".evals/${{ env.EVAL_KEY }}"
