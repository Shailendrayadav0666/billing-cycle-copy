# Eval run output. Regenerated on every run by .evals/scripts/run-evals.sh and
# uploaded as a CI artifact, so it is never committed.
.evals/evidence/

# Python bytecode outside the self-ignoring venv
__pycache__/
*.pyc

# Downloaded tool binaries (gitleaks). Not project source; never committed.
.evals/tools/

# coverage.py data file - run output, regenerated every run
.coverage
coverage.xml
