{
  "evalFrameworkVersion": "1.0.0",
  "scope": "changed-files",
  "retryLimitForSelfRepair": 3,
  "thresholds": {
    "lintErrorsAllowedDelta": 0,
    "typeErrorsAllowed": 0,
    "semgrepFindingsAllowed": { "critical": 0, "high": 0, "medium": 5 },
    "dependencyVulnerabilitiesAllowed": { "critical": 0, "high": 0 },
    "disallowedLicenses": ["GPL-2.0", "GPL-3.0", "AGPL-3.0", "SSPL-1.0"],
    "maxCyclomaticComplexity": 12,
    "secretFindingsAllowed": 0,
    "unitTestCoverageMin": 90.0,
    "behaviorScenarioPassRateMin": 100.0,
    "llmJudgeArchitectureScoreMin": 0.85,
    "llmJudgeSecurityScoreMin": 0.85,
    "securityVulnerabilitiesAllowed": 0
  },
  "behavior": {
    "containerRuntime": "podman",
    "image": "aire-behavior:local",
    "containerfile": "tests/.evals/behavior/Containerfile",
    "entrypoint": "tests/.evals/behavior/run.sh",
    "_comment": "Same image + command locally and in CI. A missing runtime degrades to native execution, recorded, never blocking."
  },
  "sonarqube": {
    "enabled": true,
    "_comment": "User answered 'proceed' at the Section 4.1.2 setup gate on 2026-09-11 and confirmed CLAUDE_CODE_OAUTH_TOKEN/SONAR_TOKEN/SONAR_HOST_URL were added as GitHub Actions secrets and sonar.organization set in sonar-project.properties. Additive to semgrep, never a replacement."
  },
  "judge": { "model": "claude-sonnet-5", "rubricVersion": "1.0.0" },
  "ci": {
    "baseBranch": "main",
    "integrationBranchPrefixes": ["epic", "bug", "enh", "ci", "story", "ve"],
    "manifestState": "resolved",
    "roots": [
      {
        "root": "src/backend",
        "stack": "python",
        "runtimeVersion": "3.13",
        "markerFile": "requirements.txt",
        "installCommands": ["pip install -r requirements.txt"],
        "buildCommand": null,
        "coverageCommand": "pytest ../../tests/unit/backend --cov=. --cov-report=xml",
        "noTestsExitCode": 5,
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage.xml",
        "coverageFormat": "cobertura",
        "sourcePaths": ["src/backend"],
        "testPaths": ["tests/unit/backend"],
        "tools": ["semgrep", "ruff", "mypy", "pip-audit", "pip-licenses", "gitleaks"],
        "toolInstallCommands": {
          "semgrep": "pip install \"setuptools<81\" \"semgrep==1.127.0\"",
          "ruff": "pip install \"ruff==0.8.4\"",
          "mypy": "pip install \"mypy==1.14.1\"",
          "pip-audit": "pip install \"pip-audit==2.9.0\"",
          "pip-licenses": "pip install \"pip-licenses==5.0.0\"",
          "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks"
        }
      },
      {
        "root": "src/frontend",
        "stack": "node",
        "runtimeVersion": "20",
        "markerFile": "package.json",
        "installCommands": ["npm install"],
        "buildCommand": "npm run build",
        "coverageCommand": "npm run test",
        "noTestsExitCode": 0,
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage/lcov.info",
        "coverageFormat": "lcov",
        "sourcePaths": ["src/frontend/src"],
        "testPaths": ["tests/unit/frontend"],
        "tools": ["semgrep", "oxlint", "license-checker", "gitleaks"],
        "toolInstallCommands": {
          "semgrep": "pip install \"setuptools<81\" \"semgrep==1.127.0\"",
          "oxlint": "npm i -D oxlint",
          "license-checker": "npm i -D license-checker",
          "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks"
        }
      }
    ],
    "gates": ["D1_lint", "D2_types", "D3_sast", "D4_deps", "D5_licenses", "D6_complexity", "D7_secrets",
              "unitCoverage", "behaviorB1", "behaviorB2", "behaviorB3", "J1_architecture", "J2_security",
              "sonarqube"],
    "_rootsComment": "noTestsExitCode is the exit status THIS root's test runner returns when it collects ZERO tests (pytest 5; vitest run with no matching files exits 1). ci-manifest-runner.* records that exit as N/A rather than FAIL for a root with genuinely no tests yet.",
    "_comment": "CI SINGLE SOURCE OF TRUTH. The generated pipeline AND every local step read THIS block."
  }
}
