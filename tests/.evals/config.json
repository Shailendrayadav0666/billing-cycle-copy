{
  "evalFrameworkVersion": "1.0.0",
  "scope": "changed-files",
  "retryLimitForSelfRepair": 3,
  "thresholds": {
    "lintErrorsAllowedDelta": 0,
    "typeErrorsAllowed": 0,
    "semgrepFindingsAllowed": {
      "critical": 0,
      "high": 0,
      "medium": 5
    },
    "dependencyVulnerabilitiesAllowed": {
      "critical": 0,
      "high": 0
    },
    "disallowedLicenses": [
      "GPL-2.0",
      "GPL-3.0",
      "AGPL-3.0",
      "SSPL-1.0"
    ],
    "maxCyclomaticComplexity": 12,
    "secretFindingsAllowed": 0,
    "unitTestCoverageMin": 90.0,
    "behaviorScenarioPassRateMin": 100.0,
    "llmJudgeArchitectureScoreMin": 0.85,
    "llmJudgeSecurityScoreMin": 0.85,
    "securityVulnerabilitiesAllowed": 0
  },
  "behavior": {
    "containerRuntime": "podman",
    "image": "aire-behavior:local",
    "containerfile": "tests/.evals/behavior/Containerfile",
    "entrypoint": "tests/.evals/behavior/run.sh",
    "_comment": "Same image + command locally and in CI. A missing runtime degrades to native execution, recorded, never blocking."
  },
  "sonarqube": {
    "enabled": false,
    "_comment": "Set true when CI generation creates sonar-project.properties and the user answers proceed at the setup gate. Additive to semgrep, never a replacement."
  },
  "playwright": {
    "enabled": false,
    "startCommand": null,
    "readinessUrl": null,
    "testCommand": "npx playwright test tests/e2e/",
    "backendStartCommand": null,
    "backendReadinessUrl": null,
    "_comment": "No implement workflow sets this. Set true by hand only when CI should re-execute the Verification Engineer's standalone /playwright-implement specs under tests/e2e/."
  },
  "judge": {
    "model": "claude-opus-5-5",
    "rubricVersion": "1.0.0"
  },
  "ci": {
    "baseBranch": "main",
    "integrationBranchPrefixes": [
      "epic",
      "bug",
      "enh",
      "ci",
      "story",
      "ve"
    ],
    "manifestState": "resolved",
    "roots": [
      {
        "root": "src/frontend",
        "stack": "node",
        "runtimeVersion": "22.14.0",
        "markerFile": "package.json",
        "installCommands": [
          "npm ci"
        ],
        "buildCommand": "npm run build",
        "coverageCommand": "npx vitest run --coverage --passWithNoTests",
        "dependsOn": [],
        "toolchainSetup": [],
        "coverageReportPath": "coverage/lcov.info",
        "coverageFormat": "lcov",
        "sourcePaths": [
          "src/frontend/src"
        ],
        "testPaths": [
          "tests/unit"
        ],
        "tools": [
          "oxlint",
          "npm-audit",
          "semgrep",
          "gitleaks"
        ],
        "toolInstallCommands": {
          "oxlint": "npm ci",
          "npm-audit": "npm ci",
          "semgrep": "pip install \"semgrep==1.127.0\"",
          "gitleaks": "gitleaks_version=8.21.2; curl -sSfL \"https://github.com/gitleaks/gitleaks/releases/download/v${gitleaks_version}/gitleaks_${gitleaks_version}_linux_x64.tar.gz\" | tar xz -C /usr/local/bin gitleaks"
        }
      }
    ],
    "gates": [
      "D1_lint",
      "D2_types",
      "D3_sast",
      "D4_deps",
      "D5_licenses",
      "D6_complexity",
      "D7_secrets",
      "unitCoverage",
      "behaviorB1",
      "behaviorB2",
      "behaviorB3",
      "J1_architecture",
      "J2_security"
    ],
    "_rootsComment": "src/frontend is the only root this cycle changes (src/backend is untouched per REQ-NF-01 and has no test runner). runtimeVersion is the locally installed Node 22.14.0 (no .node-version pin in the repo). coverageCommand assumes the Vitest + @vitest/coverage-v8 devDependencies Story 1.1 adds (REQ-NF-04); D2_types is N/A for this plain-JSX root.",
    "_comment": "CI SINGLE SOURCE OF TRUTH. CI/CD pipeline generation was declined for this cycle (## CI/CD Configuration Enabled: No); local gates read this block."
  }
}
